# X API (leave empty to run in demo mode)
X_BEARER_TOKEN=

# Optional global Slack incoming webhook. Per-rule URLs can also be set in the UI.
SLACK_WEBHOOK_URL=

# SQLite path. Docker Compose overrides this to /data/signal.db
DATABASE_PATH=./data/signal.db

# Extra Key Account handles (comma, space, or newline). @ is optional.
# Default seed is always included unless KOL_HANDLES_MODE=replace.
KOL_HANDLES=
KOL_HANDLES_MODE=append

# xAI Grok (optional). Powers the launch-pad research brief.
# Get a key at https://console.x.ai/
XAI_API_KEY=
# Optional. Defaults to grok-4-fast.
GROK_MODEL=grok-4-fast

# Accounts to drop from the inbox and alerts. Also editable on Settings → Blocked.
BLOCKED_HANDLES=

# WhatsApp alerts via Baileys (https://baileys.wiki/). Link the device in Settings.
# Destination number with country code, or a group JID like 12036...@g.us
WHATSAPP_TO=
# Auth files. Docker Compose sets /data/whatsapp-auth on the shared volume.
WHATSAPP_AUTH_DIR=

# openssl rand -base64 32   — required in production
AUTH_SECRET=
# Public URL, e.g. https://signl1.xyz
AUTH_URL=
AUTH_TRUST_HOST=true
# Skip sign-in for local preview only. Production Compose forces 0.
AUTH_DEV_LOGIN=1

# Production hostname only. Used by docker-compose.prod.yml + Caddy.
DOMAIN=
# Optional. 301 this host to DOMAIN (example: signals.signl1.xyz).
REDIRECT_FROM=

