# X API (leave empty to run in demo mode)
X_BEARER_TOKEN=

# Optional global Slack incoming webhook. Per-rule URLs can also be set in the UI.
SLACK_WEBHOOK_URL=

# SQLite path. Docker Compose overrides this to /data/signal.db
DATABASE_PATH=./data/signal.db

# Extra Key Network Node handles (comma, space, or newline). @ is optional.
# Default seed (wires, squawk, All-In, CNBC/FT, official desks) is always included
# unless KOL_HANDLES_MODE=replace.
KOL_HANDLES=
KOL_HANDLES_MODE=append

# Accounts to drop from the inbox and alerts. Also editable on Settings → Blocked.
BLOCKED_HANDLES=

# WhatsApp alerts via Baileys (https://baileys.wiki/). Link the device in Settings.
# Destination number with country code, or a group JID like 12036...@g.us
WHATSAPP_TO=
# Auth files. Docker Compose sets /data/whatsapp-auth on the shared volume.
WHATSAPP_AUTH_DIR=

# Google sign-in (Auth.js). Required on a public domain. Optional locally if AUTH_DEV_LOGIN=1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32   — required in production
AUTH_SECRET=
# Public URL of the desk, e.g. https://signals.example.com
AUTH_URL=
AUTH_TRUST_HOST=true
# Passwordless email field for local preview only. Production Compose forces 0.
AUTH_DEV_LOGIN=1
# Comma-separated Google accounts allowed to join. Set this before exposing the box.
# The first person on this list (or the first login if the list is empty) becomes admin.
AUTH_ALLOWED_EMAILS=

# Production hostname only. Used by docker-compose.prod.yml + Caddy.
DOMAIN=

